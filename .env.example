# Copy to .env.local. These defaults match Quokra's local dev setup (dev profile).

# Used in the browser: where sdk.js is served from, and the demo tenant.
VITE_QUOKRA_URL=http://localhost:8080
VITE_QUOKRA_TENANT=demo
VITE_QUOKRA_PK=pk_test_demo

# Agent login: the OIDC provider and this app's client there. Defaults: the local Keycloak
# that Quokra's compose.yaml starts.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/quokra
VITE_OIDC_CLIENT_ID=quokra-dashboard

# Used only by the dev backend (dev/quokra-api.ts), never sent to the browser.
# Quokra's dev-only secret for the demo tenant. Real secrets never go in a file that's committed.
QUOKRA_SECRET_KEY=sk_dev_demo_only_not_a_secret_0123456789abcdef
